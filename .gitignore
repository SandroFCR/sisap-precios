.venv/
tools/
.claude/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
# data/raw se queda fuera del repo: son dumps de HTML, pesados y no los
# necesita la app publicada. data/processed SI se versiona (precios.parquet
# y sisap.duckdb): es lo unico que Streamlit Cloud puede leer, porque solo
# ve lo que esta en el repo, no tu disco local.
data/raw/*
!data/raw/.gitkeep
# El warehouse se arma en memoria desde el parquet (ver
# warehouse.construir_en_memoria): versionarlo sumaba ~5 MB al repo por dia
# (19 MB, distinto byte a byte en cada corrida). `construir-dwh` lo sigue
# generando en local para consultas SQL ad hoc.
data/processed/sisap.duckdb
